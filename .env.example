# Browser/build-time values. These are embedded into the Vite build.
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_PROJECT_WHATSAPP=
VITE_PROJECT_EMAIL=

# Server/runtime values. Configure these in cPanel for production.
SUPABASE_PROJECT_ID=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Server-only secret. Leave unset until trusted server-side admin code actually uses it.
# Never prefix this with VITE_. Never commit a real value.
SUPABASE_SERVICE_ROLE_KEY=

# SEO + consent kit: public tag IDs (not secrets). Empty = tool off.
# They load only after the visitor accepts cookies (Québec Law 25 banner).
VITE_GA4_ID=
VITE_GTM_ID=
VITE_META_PIXEL_ID=
VITE_TIKTOK_PIXEL_ID=
